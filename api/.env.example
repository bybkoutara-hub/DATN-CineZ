# Port API lắng nghe (mặc định 5000 trong server.ts)
PORT=5000

# Chuỗi kết nối MongoDB (mặc định mongodb://127.0.0.1:27017/mbooking)
MONGODB_URI=mongodb://127.0.0.1:27017/mbooking

# Resend API để gửi email xác nhận đặt vé
# Đăng ký tại https://resend.com → lấy API key
RESEND_API_KEY=your_resend_api_key_here
MAIL_FROM=CineZ <noreply@qlhtt.io.vn>
